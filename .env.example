# Configure these as server-side Vercel environment variables.
# Keep .env private; never put server secrets in config.js or client-side code.
ANTHROPIC_API_KEY=

# The browser uses the public project URL and public/anon key in config.js.
# The server separately uses these to verify real, email-confirmed Supabase accounts.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Shared, deployment-wide request limits. Create a dedicated Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a unique random secret with at least 32 bytes of entropy; example on Windows:
# $bytes = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [BitConverter]::ToString($bytes).Replace("-", "").ToLowerInvariant()
RATE_LIMIT_HASH_SECRET=
